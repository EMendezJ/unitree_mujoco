<mujoco model="g1_29dof pick and place scene">
  <include file="g1_29dof.xml"/>

  <statistic center="0.3 0 0.9" extent="1.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="pick_box_mat" rgba="0.85 0.35 0.1 1"/>
    <material name="place_zone_mat" rgba="0.15 0.65 0.25 0.5"/>
  </asset>

  <!--
    Table and target positions come from forward kinematics of the right arm
    alone on g1_29dof.xml (shoulder_pitch/roll/yaw + elbow, wrist left at 0),
    with the rest of the body held at its zero pose:
      pre_grasp (sp=-45 el=45)                  -> wrist [0.328, -0.095, 0.947]
      grasp     (sp=-45 el=60)                  -> wrist [0.318, -0.101, 0.900]
      lift      (sp=-60 el=60)                  -> wrist [0.353, -0.077, 0.985]
      lift_over_place (sp=-60 el=60 sr=15 sy=40) -> wrist [0.284,  0.061, 0.961]
      place     (sp=-45 el=60 sr=15 sy=40)      -> wrist [0.255,  0.042, 0.892]
    The carry motion deliberately uses shoulder_roll/yaw rather than waist_yaw:
    the robot hangs from a free-floating pelvis (see ENABLE_ELASTIC_BAND in
    config.py), so rotating the waist also rotates the unactuated lower body
    the opposite way to conserve angular momentum, which throws off a
    world-frame target. The arm's own mass is small enough relative to the
    torso that this effect is negligible for shoulder-only motion.
    Table top is set to 0.86 so a 3cm-half-size box resting on it has its
    center at z=0.89, right under the grasp/place wrist height.
  -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="table" type="box" pos="0.35 0 0.43" size="0.20 0.35 0.43" material="table_mat"/>

    <body name="pick_box" pos="0.32 -0.10 0.89">
      <freejoint/>
      <geom name="pick_box_geom" type="box" size="0.03 0.03 0.03" material="pick_box_mat" density="500" friction="1.0 0.01 0.001"/>
    </body>

    <geom name="place_zone" type="cylinder" size="0.10 0.001" pos="0.25 0.04 0.861"
      material="place_zone_mat" contype="0" conaffinity="0"/>
  </worldbody>

  <equality>
    <!-- Inactive by default. simulate_python's Gripper helper toggles this on/off
         (key G) to approximate a closed hand, since g1_29dof.xml's rubber hand has
         no articulated fingers to actually grip with. -->
    <weld name="right_hand_grip" body1="right_wrist_yaw_link" body2="pick_box" active="false" solref="0.02 1"/>
  </equality>
</mujoco>
